/* 历史记录页面 */

.page-history {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 统计概览 */
.stats-section {
  margin-bottom: 40rpx;
}

.stats-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.stat-card {
  flex: 1;
  background: rgba(255, 255, 255, 0.05);
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  font-variant-numeric: tabular-nums;
  margin-bottom: 6rpx;
}

.stat-card:first-child .stat-value {
  color: #e94560;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

.stats-sub {
  text-align: center;
}

.stats-sub-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.3);
}

/* 记录列表 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
}

.clear-btn {
  font-size: 26rpx;
  color: #e94560;
  padding: 8rpx 16rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-card {
  background: rgba(255, 255, 255, 0.04);
  border: 2rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}

.record-best {
  border-color: rgba(233, 69, 96, 0.25);
  background: rgba(233, 69, 96, 0.06);
}

.record-card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.record-mode-icon {
  font-size: 36rpx;
}

.record-info {
  display: flex;
  flex-direction: column;
}

.record-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.record-mode-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.3);
}

.record-right {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.record-time {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  font-variant-numeric: tabular-nums;
}

.record-time-best {
  color: #e94560;
}

.record-time-unit {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.35);
}

.record-best-badge {
  background: #e94560;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  margin-left: 10rpx;
}

.badge-text {
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.record-card-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.record-max-speed {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.3);
}

.record-delete {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.25);
  padding: 4rpx 16rpx;
}

.record-delete:active {
  color: #e94560;
}
